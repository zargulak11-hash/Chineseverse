# Copy to .env at the repo root — this is read by `docker compose up`.
# It's separate from backend/.env and frontend/.env, which are used when
# running the app directly on the host without Docker; docker-compose.yml
# still loads backend/.env for the app's own settings (JWT_SECRET,
# GOOGLE_CLIENT_ID, AI_*, ...) and only overrides DATABASE_URL so the
# backend container talks to the "postgres" service instead of localhost.

# --- Postgres (used only inside the Docker network) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=linguaverse

# --- Frontend build-time ---
# Vite env vars are baked into the static build, so for `docker compose
# build` this has to be set here (not just in frontend/.env) — see
# backend/.env.example for how to create a Google OAuth client ID.
VITE_GOOGLE_CLIENT_ID=
