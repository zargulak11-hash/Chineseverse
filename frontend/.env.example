# Copy to .env (same directory) and restart `npm run dev` after changing it.

# Must match backend/.env's GOOGLE_CLIENT_ID exactly — see backend/.env.example
# for how to create one in Google Cloud Console.
# For Android app builds, put the production web client id in .env.mobile
# (same variable): the app falls back to it when the server doesn't name its
# own (docs/MOBILE_APP.md, "Google sign-in in the Android app").
VITE_GOOGLE_CLIENT_ID=
