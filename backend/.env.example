# Copy to .env and adjust for your local setup. Never commit the real .env file.

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/linguaverse
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Auth -----------------------------------------------------------------
# Generate a real secret for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
# Reverse proxies between the learner and the API that append X-Forwarded-For
# (0 when uvicorn is reached directly). docker-compose.yml sets this itself.
TRUSTED_PROXY_HOPS=0

# --- Google Sign-In ---------------------------------------------------------
# Create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials, add your frontend
# origin under "Authorized JavaScript origins" (local:
# http://localhost:5173; production: https://chineseverse.qobus.tj), then
# paste the client ID below. The frontend needs the SAME value in
# frontend/.env as VITE_GOOGLE_CLIENT_ID. No redirect URI is needed (the
# button returns an ID token to the page). While the consent screen is in
# "Testing", only listed test users can sign in -- publish it for everyone.
GOOGLE_CLIENT_ID=
# Not required for the Google Identity Services ID-token flow used today;
# reserved for a future server-side authorization-code flow.
GOOGLE_CLIENT_SECRET=

# --- GitHub sign-in ----------------------------------------------------------
# Create an OAuth App at https://github.com/settings/developers ("New OAuth
# App"). GitHub allows ONE callback URL per app, so use one app per
# environment:
#   local:      Homepage http://localhost:5173
#               Callback http://localhost:5173/api/auth/github/callback
#   production: Homepage https://chineseverse.qobus.tj
#               Callback https://chineseverse.qobus.tj/api/auth/github/callback
# The callback is answered by this API but reached through the frontend's
# origin (Vite proxy / nginx). The secret stays here -- never in frontend/.env.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must equal the app's callback URL exactly. Unset = PUBLIC_APP_URL +
# /api/auth/github/callback, which is right for production; for local
# development set it to http://localhost:5173/api/auth/github/callback.
GITHUB_REDIRECT_URI=

# --- AI teacher / voice evaluation -----------------------------------------
# Google Gemini (key from https://aistudio.google.com/apikey). "auto" uses
# Gemini when GEMINI_API_KEY is set, otherwise a deterministic offline mode
# so the app fully works with no key configured.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional; gemini-2.5-flash is retired for new keys (HTTP 404).
GEMINI_MODEL=gemini-3.8-flash

# --- Email (notification emails, e.g. "X followed you") ------------------
# Leave SMTP_HOST empty to disable email: notifications are still stored and
# shown in the app. Any SMTP provider works (Gmail/Workspace with an app
# password, Mailgun, Amazon SES SMTP, Yandex, ...). Never commit real values.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender shown to recipients, e.g. ChineseVerse <no-reply@your-domain>
SMTP_FROM=
# Public frontend address used for links inside emails
PUBLIC_APP_URL=https://chineseverse.qobus.tj
